{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/toolchains/cli/schema/tauri.schema.json",
  "productName": "Eco11",
  "version": "1.0.0",
  "identifier": "com.eco11.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Eco11 - Apple Ecosystem Bridge",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
